# Backend (CodeIgniter 4)
backend/vendor/
backend/.env
backend/writable/*.db
backend/writable/cache/*
!backend/writable/cache/index.html
backend/writable/logs/*
!backend/writable/logs/index.html
backend/writable/session/*
!backend/writable/session/index.html
backend/writable/debugbar/*
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Mobile (Expo)
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/*.log

# OS
.DS_Store
Thumbs.db
.thumbnail/
